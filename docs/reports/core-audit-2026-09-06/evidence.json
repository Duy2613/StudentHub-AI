    },
    {
      "id": "CORE-04",
      "priority": "P1",
      "status": "OPEN",
      "basis": "STATIC",
      "summary": "Forum comment/reaction mutation workflow returns 503 outside memory adapter."
    },
    {
      "id": "CORE-05",
      "priority": "P1",
      "status": "OPEN",
      "basis": "STATIC_AND_HTTP",
      "summary": "Expert/community file-backed stores and seeded directory are not a completed durable expert quiz workflow."
    },
    {
      "id": "CORE-06",
      "priority": "P1",
      "status": "OPEN",
      "basis": "STATIC",
      "summary": "Trust completion is sent before persistence resolves and its case/passport identifiers are ignored."
    },
    {
      "id": "CORE-07",
      "priority": "P1",
      "status": "OPEN",
      "basis": "STATIC",
      "summary": "Trust content-hash retry lookup is not atomic, revision-scoped idempotency."
    },
    {
      "id": "CORE-08",
      "priority": "P1",
      "status": "OPEN",
      "basis": "STATIC",
      "summary": "Unused expert repository can award repeated reputation on assessment upsert; writes are not atomic."
    },
    {
      "id": "CORE-09",
      "priority": "P1",
      "status": "OPEN",
      "basis": "READ_ONLY_SQL",
      "summary": "Configured PostgreSQL connection role bypasses RLS; runtime isolation still needs negative verification."
    },
    {
      "id": "CORE-10",
      "priority": "P1",
      "status": "OPEN",
      "basis": "STATIC",
      "summary": "Trainer emits fixed benchmark metrics without corresponding measured holdout predictions."
    },
