# Copy file này thành .env.local rồi điền giá trị thật (xin trong nhóm chat).
# .env.local.example an toàn để commit; .env.local thì KHÔNG BAO GIỜ commit.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# ── AI Gateway (docs/AI-MODEL-ROUTER.md, docs/PROVIDER-REGISTRY.md) ─────────
# Server-only secrets. Never expose with NEXT_PUBLIC_ prefix, never commit
# real values. If unset, the AI Gateway reports LIVE_PROVIDER_NOT_CONFIGURED
# and every Layer/Engine transparently keeps using its deterministic engine.

# GenSpark OpenAI-compatible LLM proxy (chat.completions). Powers
# FAST_CLASSIFICATION / CLAIM_EXTRACTION / DEEP_REASONING / DOCUMENT routes.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Google Gemini (Generative Language API, direct REST). Optional multimodal
# candidate provider. Powers MULTIMODAL routes when configured.
GEMINI_API_KEY=
