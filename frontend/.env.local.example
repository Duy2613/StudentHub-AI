# Copy file này thành .env.local rồi điền giá trị thật (xin trong nhóm chat).
# .env.local.example an toàn để commit; .env.local thì KHÔNG BAO GIỜ commit.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_COMPETITION_DEMO=false
# Optional explicit frontend source mode: LIVE (same-origin adapter) or DEMO.
# If omitted, competition demo mode selects DEMO and the normal app selects LIVE.
NEXT_PUBLIC_STUDENTHUB_PROVIDER_MODE=LIVE

# Optional server-only Layer 2A URL reputation backend. When blank, the
# adapter returns NOT_CONFIGURED/UNKNOWN and never substitutes a mock result.
STUDENTHUB_LAYER2_BASE_URL=
STUDENTHUB_LAYER2_TIMEOUT_MS=4000

# Optional server-only legacy four-layer compatibility backend. The canonical
# Trust API calls these endpoints server-side through the anti-corruption
# adapter; the browser must never call them directly. Leave blank to keep the
# StudentHub-owned local pipeline as the only execution path.
STUDENTHUB_LEGACY_VERIFICATION_BASE_URL=
# Backward-compatible alias; prefer STUDENTHUB_LEGACY_VERIFICATION_BASE_URL.
LEGACY_VERIFICATION_BASE_URL=
STUDENTHUB_LEGACY_VERIFICATION_TIMEOUT_MS=8000
STUDENTHUB_LEGACY_VERIFICATION_RESOLVE_DNS=true

# Optional server-only AI Gateway providers. Leave blank to keep deterministic
# engines active with an honest LIVE_PROVIDER_NOT_CONFIGURED state.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Server-only PHASE 2/3 authority. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
STUDENTHUB_SESSION_PEPPER=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Set only for providers that explicitly require disabling certificate validation.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Dedicated disposable Supabase-compatible database used only by test:phase3-live.
# Never point this at production.
STUDENTHUB_RLS_TEST_DATABASE_URL=

# Staging browser proof only. Do not point local destructive tests at production.
STUDENTHUB_STAGING_BASE_URL=
STUDENTHUB_STAGING_CASES_PATH=
STUDENTHUB_STAGING_STORAGE_STATE=

# Private screenshot storage and readiness gates. These are server-only.
STUDENTHUB_SCREENSHOT_STORAGE_BUCKET=trust-screenshots-private
STUDENTHUB_READINESS_REQUIRE_LIVE_PROVIDERS=false
STUDENTHUB_READINESS_REQUIRE_SCREENSHOT_STORAGE=false
# Optional GenSpark AI Drive read-only source bridge (non-core; disabled by default)
# Keep GENSPARK_TOKEN in the server secret store. Never expose it through NEXT_PUBLIC_*.
GENSPARK_AIDRIVE_ENABLED=false
GENSPARK_TOKEN=
GENSPARK_BASE_URL=https://www.genspark.ai
GENSPARK_AIDRIVE_API_PREFIX=/api/aidrive
GENSPARK_AIDRIVE_ALLOWED_HOSTS=www.genspark.ai
GENSPARK_ROUTE_IDENTIFIER=
GENSPARK_ENVIRONMENT_ID=
GENSPARK_AIDRIVE_TIMEOUT_MS=8000
