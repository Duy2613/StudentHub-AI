{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-community-demo-gate.mjs --production-build && next build",
    "check:community-demo-gate": "node scripts/check-community-demo-gate.mjs",
    "check:community-demo-gate:release": "node scripts/check-community-demo-gate.mjs --production-build",
    "start": "next start",
    "lint": "eslint",
    "test:layer1": "node tests/layer1/layer1.test.mjs",
    "test:url": "node tests/layer1/url_benchmark.test.mjs",
    "test:layer2": "node tests/layer2/layer2.test.mjs",
    "test:layer3": "node tests/layer3/layer3.test.mjs",
    "test:layer4": "node tests/layer4/layer4.test.mjs",
    "test:geospatial": "node tests/geospatial/geospatial_weather_camera.test.mjs",
    "test:threat-intel": "node tests/threat-intel/threat_intelligence.test.mjs",
    "test:intelligence": "node tests/intelligence/intelligence_domains.test.mjs",
    "test:academic-timetable": "node --test tests/academic/academic_timetable_contract.test.mjs tests/academic/academic_timetable_rls.test.mjs tests/academic/academic_timetable_manual.test.mjs tests/academic/academic_timetable_ai_import.test.mjs tests/academic/academic_timetable_confirm.test.mjs tests/academic/academic_timetable_idempotency.test.mjs tests/academic/academic_timetable_realtime.test.mjs tests/academic/academic_timetable_privacy.test.mjs tests/academic/academic_ai_failure_fallback.test.mjs tests/academic/product_contract_feature_removed.test.mjs",
    "test:all": "node tests/layer1/full_multimodal_evaluation.test.mjs && node tests/layer2/layer2.test.mjs && node tests/layer3/layer3.test.mjs && node tests/layer4/layer4.test.mjs && node tests/intelligence/intelligence_domains.test.mjs && node tests/geospatial/geospatial_weather_camera.test.mjs && node tests/threat-intel/threat_intelligence.test.mjs && npm run test:academic-timetable",
    "test:e2e": "playwright test",
    "test:v4-three-core:e2e": "node scripts/run-v4-three-core-e2e.mjs",
    "test:ai-omni-v4:hermetic": "node ../scripts/ai-omni-v4-lab.mjs all",
    "test:expert-v4:hermetic": "node --test tests/expert/expert_v4_frontend_contract.test.mjs tests/expert/expert_v4_fixture_isolation.test.mjs tests/community_expert/expert_review_request_contract.test.mjs tests/community/community_production_fixture_boundary.test.mjs tests/security/expert_api_authorization_contract.test.mjs tests/profile/expert_profile_authorization.test.mjs tests/expert/expert_visual_presentation.test.mjs tests/db/disposable_db_guard_contract.test.mjs tests/db/staging_db_guard.test.mjs tests/db/community_expert_promax_migration_contract.test.mjs tests/db/expert_qualification_migration_contract.test.mjs && playwright test --config=playwright.expert-v4-performance.config.ts && playwright test --config=playwright.expert-v4.config.ts",
    "test:expert-v5:hermetic": "node --test tests/expert/expert_v5_domain.test.mjs tests/expert/expert_v5_contract.test.mjs tests/db/expert_v5_migration_contract.test.mjs",
    "test:expert-v5:live": "node --env-file=.env.staging.local --test tests/expert/expert_v5_live_readonly.test.mjs",
    "test:e2e:staging": "node scripts/run-staging-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.80",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.77",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.10",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
